{
  "name": "AutoWorker",
  "defaultBranch": "master",
  "github": {
    "owner": "Maliniak93",
    "repo": "AutoWorker",
    "projectNumber": 2
  },
  "planDir": "docs/plan",
  "areas": [
    {
      "name": "Code",
      "paths": [
        "src/",
        "tests/"
      ],
      "tests": true,
      "implementer": [
        "dev-playbook"
      ],
      "testWriter": [
        "testing-playbook"
      ],
      "checklist": [
        "Code"
      ]
    },
    {
      "name": "Claude",
      "paths": [
        ".claude/",
        "CLAUDE.md",
        ".mcp.json"
      ],
      "tests": false,
      "implementer": [
        "claude-playbook"
      ],
      "testWriter": [],
      "checklist": [
        "Claude"
      ]
    },
    {
      "name": "Scripts",
      "paths": [
        "scripts/"
      ],
      "tests": false,
      "implementer": [
        "scripts-playbook"
      ],
      "testWriter": [],
      "checklist": [
        "Scripts"
      ]
    },
    {
      "name": "CI/Infra",
      "paths": [
        ".github/",
        "Dockerfile",
        "docker-compose*.yml",
        ".gitignore",
        ".editorconfig"
      ],
      "tests": false,
      "implementer": [
        "ops-playbook"
      ],
      "testWriter": [],
      "checklist": [
        "CI/Infra"
      ]
    },
    {
      "name": "Docs",
      "paths": [
        "docs/",
        "README.md",
        "*.md"
      ],
      "tests": false,
      "implementer": [],
      "testWriter": [],
      "checklist": [
        "Docs"
      ]
    }
  ],
  "verify": {
    "fullScope": [
      "package.json",
      "package-lock.json",
      ".github/workflows/",
      "project.config.json"
    ],
    "steps": [
      {
        "name": "scripts-test",
        "cmd": [
          "node",
          "--test",
          "scripts/*.test.mjs"
        ],
        "areas": [
          "Scripts"
        ]
      }
    ]
  },
  "preflight": {
    "tools": [
      "node",
      "git",
      "gh"
    ],
    "extra": []
  },
  "formatOnEdit": [
    {
      "ext": [
        ".ts",
        ".tsx",
        ".js",
        ".mjs",
        ".json",
        ".css",
        ".scss",
        ".html",
        ".md"
      ],
      "cmd": [
        "npx",
        "--no-install",
        "prettier",
        "--write"
      ]
    }
  ]
}

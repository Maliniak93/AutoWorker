{
  "name": "autoworker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "prestart": "vite build",
    "start": "node --env-file-if-exists=.env src/server/main.ts",
    "dev": "node --watch --env-file-if-exists=.env src/server/main.ts & vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "format": "prettier --write src tests package.json tsconfig.json vite.config.ts .prettierrc.json",
    "format:check": "prettier --check src tests package.json tsconfig.json vite.config.ts .prettierrc.json"
  },
  "dependencies": {
    "@fastify/static": "^10.1.8",
    "fastify": "^5.12.7",
    "node-pty": "^1.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
